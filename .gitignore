# ignore poems in data files
backend/poems/*.txt
backend/poems/route*.json
backend/data/poetry_graph_backup_133225.json
backend/reports/*.txt

# Ignore generated audio files
backend/audio/*.mp3

# Ignore the entire virtual environment directory
backend/venv/

# Ignore all Python pycache files
backend/**/__pycache__/

# Ignore the frontend node_modules directory
frontend/node_modules/

# ignore environment variable files
*.env
*.env.local
*.env.*.local

# Ignore deployment artifacts
*.zip

scripts/setup_github_secret.sh
