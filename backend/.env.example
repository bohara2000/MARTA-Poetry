# ============================================================
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your own values
# IMPORTANT: Never commit .env with real secrets to version control
#
# For production deployments to Azure:
#   - Secrets are retrieved from Azure Key Vault via managed identities
#   - Set COSMOS_ENDPOINT and COSMOS_KEY values from Key Vault
#   - Set STORAGE_* values from Key Vault
#
# For local development:
#   - Use the Cosmos DB emulator (default values below)
#   - Fill in your own API keys for third-party services

# ============================================================
# Cosmos DB Configuration
# ============================================================
# For production: Values retrieved from Azure Key Vault
# For local development: Use Cosmos DB emulator values
COSMOS_ENDPOINT=https://localhost:8081/
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30ESCV8QrQrF+jV7rIcgI=
COSMOS_DATABASE=PoetryDatabase
COSMOS_CONTAINER=poems
COSMOS_CONTAINER_POEMS=poems
COSMOS_CONTAINER_ROUTES=routes
COSMOS_CONTAINER_PERSONALITIES=personalities
COSMOS_CONTAINER_GRAPH=graph

# ============================================================
# Azure Storage Configuration
# ============================================================
# For production: Values retrieved from Azure Key Vault
# For local development: Use Azure Storage Emulator or live account
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=
STORAGE_CONNECTION_STRING=
AUDIO_CONTAINER_NAME=audio

# ============================================================
# MARTA Poetry Configuration
# ============================================================
POETRY_MODE=development
DEFAULT_STORY_INFLUENCE=0.7
DEFAULT_LATITUDE=33.7490
DEFAULT_LONGITUDE=-84.3880

# ============================================================
# Weather Service
# ============================================================
NWS_ENABLED=false
NWS_WEATHER_TTL_SECONDS=300

# ============================================================
# MARTA Real-Time Data
# ============================================================
# Bus real-time (GTFS-RT)
GTFS_RT_ENABLED=true
GTFS_RT_VEHICLE_POSITIONS_URL=https://gtfs-rt.itsmarta.com/TMGTFSRealTimeWebService/vehicle/vehiclepositions.pb
GTFS_RT_API_KEY=

# Rail real-time
RAIL_RT_ENABLED=true
RAIL_RT_URL=https://developerservices.itsmarta.com:18096/itsmarta/railrealtimearrivals/developerservices/traindata
RAIL_RT_API_KEY=

# Static GTFS data
GTFS_API_KEY=

# ============================================================
# Mapbox Configuration
# ============================================================
MAPBOX_ENABLED=true
MAPBOX_ACCESS_TOKEN=
MAPBOX_GEOCODE_BASE_URL=https://api.mapbox.com/geocoding/v5/mapbox.places
MAPBOX_GEOCODE_LIMIT=5
MAPBOX_TRAFFIC_ENABLED=false
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5/mapbox
MAPBOX_TRAFFIC_TTL_SECONDS=120

# ============================================================
# Solar Events
# ============================================================
SOLAR_EVENTS_ENABLED=true
SOLAR_EVENTS_TTL_SECONDS=3600

# ============================================================
# Historical Context
# ============================================================
HISTORY_CONTEXT_ENABLED=true
HISTORY_CONTEXT_MAX_ITEMS=3
HISTORY_CONTEXT_LOCATION_HINT=Atlanta, GA

# ============================================================
# Wikipedia & Wikidata
# ============================================================
WIKIPEDIA_SUMMARY_BASE_URL=https://en.wikipedia.org/api/rest_v1/page/summary
WIKIDATA_SEARCH_URL=https://www.wikidata.org/w/api.php

# ============================================================
# OpenAI Configuration
# ============================================================
# OpenAI API Key (if using OpenAI directly)
OPENAI_API_KEY=

# ============================================================
# Azure OpenAI Configuration
# ============================================================
# Primary endpoint (used for poem generation)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Alternate endpoint for titles (optional)
AZURE_OPENAI_API_KEY_TITLES=
AZURE_OPENAI_ENDPOINT_TITLES=
AZURE_OPENAI_DEPLOYMENT_NAME_TITLES=gpt-4o
AZURE_OPENAI_API_VERSION_TITLES=2024-12-01-preview
